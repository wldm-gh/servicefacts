    legal:module "core" ;
    legal:priority "Low" .

schema:url a rdf:Property ;
    rdfs:label "url" ;
    rdfs:comment "The main-site page for this entity. For Acts and bodies: the official URL." ;
    schema:domainIncludes schema:GovernmentOrganization,
        schema:LegalService,
        schema:Legislation,
        schema:Person,
        schema:Service ;
    schema:isPartOf <https://schema.org> ;
    legal:module "core" ;
    legal:priority "High" .

schema:validIn a rdf:Property ;
    rdfs:label "validIn" ;

    legal:priority "Medium" .

schema:worksFor a rdf:Property ;
    rdfs:label "worksFor" ;
    rdfs:comment "Standard schema.org property." ;
    schema:domainIncludes schema:Person ;
    schema:isPartOf <https://schema.org> ;
    legal:module "core" ;
    legal:priority "High" .

legal:actsFor a rdf:Property ;
    rdfs:label "actsFor" ;
    rdfs:comment "A party role the firm or lawyer acts for in this kind of matter. Value from the PartyRoles list." ;
    schema:domainIncludes schema:LegalService,
        schema:Person,
        schema:Service ;
    schema:isPartOf <https://w3id.org/servicefacts/legal> ;
    schema:rangeIncludes schema:DefinedTerm ;
    legal:answersQuestion "Do you act for subcontractors / homeowners / builders?" ;
    legal:dualPublishAs "audience (Audience + audienceType text)" ;
    legal:module "core" ;
    legal:priority "High" ;
    legal:priorityEvidence "Hypothesis v0.1: from a review of law-firm service pages and the questions buyers ask. To be measured with AI prompt tracking." ;
    legal:visibleTextRequired true .

legal:appliesToStep a rdf:Property ;
    rdfs:label "appliesToStep" ;
    rdfs:comment "The step that must be done in time, e.g. 'Payment schedule'." ;
    schema:domainIncludes legal:TimeLimit ;
    schema:isPartOf <https://w3id.org/servicefacts/legal> ;
    schema:rangeIncludes schema:DefinedTerm ;
    legal:answersQuestion "(part of a time limit)" ;
    legal:module "core" ;
    legal:priority "High" ;
    legal:priorityEvidence "Hypothesis v0.1: from a review of law-firm service pages and the questions buyers ask. To be measured with AI prompt tracking." ;
    legal:visibleTextRequired true .

legal:consequenceIfMissed a rdf:Property ;
    rdfs:label "consequenceIfMissed" ;
    rdfs:comment "Plain statement of what happens if the step is late or missed." ;
    schema:domainIncludes legal:TimeLimit ;
    schema:isPartOf <https://w3id.org/servicefacts/legal> ;
    schema:rangeIncludes schema:Text ;
    legal:answersQuestion "What happens if I miss the deadline?" ;
    legal:module "core" ;
    legal:priority "Medium" ;
    legal:priorityEvidence "Hypothesis v0.1: from a review of law-firm service pages and the questions buyers ask. To be measured with AI prompt tracking." ;
    legal:visibleTextRequired true .

legal:contractForm a rdf:Property ;
    rdfs:label "contractForm" ;
    rdfs:comment "A standard-form contract the firm drafts, reviews or disputes. Value: a CreativeWork node for the contract form." ;
    schema:domainIncludes schema:LegalService,
        schema:Person,
        schema:Service ;
    schema:isPartOf <https://w3id.org/servicefacts/legal> ;
    schema:rangeIncludes schema:CreativeWork ;
    legal:answersQuestion "Can you review my HIA / Master Builders / AS 4000 contract?" ;
    legal:dualPublishAs "knowsAbout on the firm and the lawyer" ;
    legal:module "construction" ;
    legal:priority "High" ;
    legal:priorityEvidence "Hypothesis v0.1: from a review of law-firm service pages and the questions buyers ask. To be measured with AI prompt tracking." ;
    legal:visibleTextRequired true .

legal:countedFrom a rdf:Property ;
    rdfs:label "countedFrom" ;
    rdfs:comment "The event the time runs from, e.g. 'Payment claim served'." ;
    schema:domainIncludes legal:TimeLimit ;
    schema:isPartOf <https://w3id.org/servicefacts/legal> ;
    schema:rangeIncludes schema:DefinedTerm ;
    legal:answersQuestion "(part of a time limit)" ;
    legal:module "core" ;
    legal:priority "High" ;
    legal:priorityEvidence "Hypothesis v0.1: from a review of law-firm service pages and the questions buyers ask. To be measured with AI prompt tracking." ;
    legal:visibleTextRequired true .

legal:dateAdmitted a rdf:Property ;
    rdfs:label "dateAdmitted" ;
    rdfs:comment "Date the lawyer was admitted to practise. schema.org credentials have no award date." ;
    schema:domainIncludes schema:EducationalOccupationalCredential,
        schema:Person ;
    schema:isPartOf <https://w3id.org/servicefacts/legal> ;
    schema:rangeIncludes schema:Date ;
    legal:answersQuestion "How experienced is the lawyer?" ;
    legal:module "core" ;
    legal:priority "High" ;
    legal:priorityEvidence "Hypothesis v0.1: from a review of law-firm service pages and the questions buyers ask. To be measured with AI prompt tracking." ;
    legal:visibleTextRequired true .

legal:disputeProcess a rdf:Property ;
    rdfs:label "disputeProcess" ;
    rdfs:comment "A dispute-resolution process the service can use or lead to. Value from the DisputeProcesses list." ;
    schema:domainIncludes schema:Service ;
    schema:isPartOf <https://w3id.org/servicefacts/legal> ;
    schema:rangeIncludes schema:DefinedTerm ;
    legal:answersQuestion "Will this go to court? Can it be settled by mediation or adjudication?" ;
    legal:module "core" ;
    legal:priority "High" ;
    legal:priorityEvidence "Hypothesis v0.1: from a review of law-firm service pages and the questions buyers ask. To be measured with AI prompt tracking." ;
    legal:visibleTextRequired true .

legal:feeArrangement a rdf:Property ;
    rdfs:label "feeArrangement" ;
    rdfs:comment "How the firm charges for this kind of matter. Value from the FeeArrangements list." ;
    schema:domainIncludes schema:Offer,
        schema:Service ;
    schema:isPartOf <https://w3id.org/servicefacts/legal> ;
    schema:rangeIncludes schema:DefinedTerm ;
    legal:answersQuestion "Is it a fixed fee? Do you charge by the hour? Is the first meeting free?" ;
    legal:dualPublishAs "offers → Offer with price / priceSpecification, when a price is published" ;
    legal:module "core" ;
    legal:priority "High" ;
    legal:priorityEvidence "Hypothesis v0.1: from a review of law-firm service pages and the questions buyers ask. To be measured with AI prompt tracking." ;
    legal:visibleTextRequired true .

legal:forum a rdf:Property ;
    rdfs:label "forum" ;
    rdfs:comment "A court, tribunal, government scheme or appointing body where this kind of matter is decided or resolved." ;
    schema:domainIncludes schema:Service ;
    schema:isPartOf <https://w3id.org/servicefacts/legal> ;
    schema:rangeIncludes schema:GovernmentOrganization,
        schema:Organization ;
    legal:answersQuestion "Which court or tribunal hears this? Who appoints the adjudicator?" ;
    legal:dualPublishAs "WebPage.mentions" ;
    legal:module "core" ;
    legal:priority "High" ;
    legal:priorityEvidence "Hypothesis v0.1: from a review of law-firm service pages and the questions buyers ask. To be measured with AI prompt tracking." ;
    legal:visibleTextRequired true .

legal:governingLegislation a rdf:Property ;
    rdfs:label "governingLegislation" ;
    rdfs:comment "An Act, regulation or section that governs this kind of matter or defines this term." ;
    schema:domainIncludes schema:DefinedTerm,
        schema:Service ;
    schema:isPartOf <https://w3id.org/servicefacts/legal> ;
    schema:rangeIncludes schema:Legislation ;
    legal:answersQuestion "Which law covers my situation?" ;
    legal:dualPublishAs "WebPage.citation" ;
    legal:module "core" ;
    legal:priority "High" ;
    legal:priorityEvidence "Hypothesis v0.1: from a review of law-firm service pages and the questions buyers ask. To be measured with AI prompt tracking." ;
    legal:visibleTextRequired true .

legal:hasTimeLimit a rdf:Property ;
    rdfs:label "hasTimeLimit" ;
    rdfs:comment "A legal time limit that applies. Every practice area has these (limitation periods, response deadlines)." ;
    schema:domainIncludes schema:DefinedTerm,
        schema:Legislation,
        schema:Service ;
    schema:isPartOf <https://w3id.org/servicefacts/legal> ;
    schema:rangeIncludes legal:TimeLimit ;
    legal:answersQuestion "How long do I have to respond / to claim / to appeal?" ;
    legal:module "core" ;
    legal:priority "High" ;
    legal:priorityEvidence "Hypothesis v0.1: from a review of law-firm service pages and the questions buyers ask. To be measured with AI prompt tracking." ;
    legal:visibleTextRequired true .

legal:legalSource a rdf:Property ;
    rdfs:label "legalSource" ;
    rdfs:comment "The Act or section that sets the time limit. Use a Legislation node for the section, isPartOf the Act." ;
    schema:domainIncludes legal:TimeLimit ;
    schema:isPartOf <https://w3id.org/servicefacts/legal> ;
    schema:rangeIncludes schema:Legislation ;
    legal:answersQuestion "(part of a time limit)" ;
    legal:module "core" ;
    legal:priority "High" ;
    legal:priorityEvidence "Hypothesis v0.1: from a review of law-firm service pages and the questions buyers ask. To be measured with AI prompt tracking." ;
    legal:visibleTextRequired true .

legal:matterValueRange a rdf:Property ;
    rdfs:label "matterValueRange" ;
    rdfs:comment "The claim or deal values the firm usually handles for this service (MonetaryAmount with minValue / maxValue)." ;
    schema:domainIncludes schema:Service ;
    schema:isPartOf <https://w3id.org/servicefacts/legal> ;
    schema:rangeIncludes schema:MonetaryAmount ;
    legal:answersQuestion "Do you take small claims? Is my matter big enough?" ;
    legal:module "core" ;
    legal:priority "Medium" ;
    legal:priorityEvidence "Hypothesis v0.1: from a review of law-firm service pages and the questions buyers ask. To be measured with AI prompt tracking." ;
    legal:visibleTextRequired true .

legal:projectType a rdf:Property ;
    rdfs:label "projectType" ;
    rdfs:comment "The kind of building project the service covers. Value from the ProjectTypes list." ;
    schema:domainIncludes schema:Service ;
    schema:isPartOf <https://w3id.org/servicefacts/legal> ;
    schema:rangeIncludes schema:DefinedTerm ;
    legal:answersQuestion "Do you handle home builds, renovations, apartments or commercial projects?" ;
    legal:module "construction" ;
    legal:priority "Medium" ;
    legal:priorityEvidence "Hypothesis v0.1: from a review of law-firm service pages and the questions buyers ask. To be measured with AI prompt tracking." ;
    legal:visibleTextRequired true .

legal:timeAllowed a rdf:Property ;
    rdfs:label "timeAllowed" ;
    rdfs:comment "How much time. QuantitativeValue with value and unitText, e.g. 10 + 'business days'." ;
    schema:domainIncludes legal:TimeLimit ;
    schema:isPartOf <https://w3id.org/servicefacts/legal> ;
    schema:rangeIncludes schema:QuantitativeValue ;
    legal:answersQuestion "(part of a time limit)" ;
    legal:module "core" ;
    legal:priority "High" ;
    legal:priorityEvidence "Hypothesis v0.1: from a review of law-firm service pages and the questions buyers ask. To be measured with AI prompt tracking." ;
    legal:visibleTextRequired true .

legal:typicalDuration a rdf:Property ;
    rdfs:label "typicalDuration" ;
    rdfs:comment "The usual time from instruction to outcome, as a range. Must come from the firm, not a guess." ;
    schema:domainIncludes schema:Service ;
    schema:isPartOf <https://w3id.org/servicefacts/legal> ;
    schema:rangeIncludes schema:Duration,
        schema:QuantitativeValue ;
    legal:answersQuestion "How long will it take?" ;
    legal:module "core" ;
    legal:priority "Medium" ;
    legal:priorityEvidence "Hypothesis v0.1: from a review of law-firm service pages and the questions buyers ask. To be measured with AI prompt tracking." ;
    legal:visibleTextRequired true .

legal:DisputeProcesses-adjudication a schema:DefinedTerm ;
    skos:broadMatch <http://www.wikidata.org/entity/Q357789> ;
    skos:relatedMatch <http://www.wikidata.org/entity/Q7445053> ;
    schema:description "A fast, binding interim decision on a payment dispute under security of payment law." ;
    schema:inDefinedTermSet legal:DisputeProcesses ;
    schema:name "Statutory adjudication" ;
    schema:termCode "adjudication" .


@prefix legal: <https://w3id.org/servicefacts/legal#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

legal:TimeLimit a rdfs:Class ;
    rdfs:label "TimeLimit" ;
    rdfs:comment "A legal time limit: a step that must be done within a set time, counted from a set event, under a named law." ;
    rdfs:subClassOf schema:StructuredValue .

schema:about a rdf:Property ;
    rdfs:label "about" ;
    rdfs:comment "Credential: the specialist area. Page: the main Service it is about." ;
    schema:domainIncludes schema:EducationalOccupationalCredential,
        schema:WebPage ;
    schema:isPartOf <https://schema.org> ;
    legal:module "core" ;
    legal:priority "High" .

schema:address a rdf:Property ;
    rdfs:label "address" ;
    rdfs:comment "One LegalService node per office." ;
    schema:domainIncludes schema:LegalService ;
    schema:isPartOf <https://schema.org> ;
    legal:module "core" ;
    legal:priority "High" .

schema:alternateName a rdf:Property ;
    rdfs:label "alternateName" ;
    rdfs:comment "Short names people use: 'SOPA', 'VCAT'." ;
    schema:domainIncludes schema:GovernmentOrganization,
        schema:Legislation ;
    schema:isPartOf <https://schema.org> ;
    legal:module "core" ;
    legal:priority "High" .

schema:alumniOf a rdf:Property ;
    rdfs:label "alumniOf" ;
    rdfs:comment "Standard schema.org property." ;
    schema:domainIncludes schema:Person ;
    schema:isPartOf <https://schema.org> ;
    legal:module "core" ;
    legal:priority "Medium" .

schema:areaServed a rdf:Property ;

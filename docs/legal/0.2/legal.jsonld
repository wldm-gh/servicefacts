      "@id": "legal:damagesCap",
      "@type": "rdf:Property",
      "rdfs:label": "damagesCap",
      "rdfs:comment": "What the law says about a limit (a cap) on one kind of damages in this kind of case: the limit, or that there is none. Repeat for each cap, for example a lower and a higher cap. Not for fee caps, insurance policy limits or benefit limits, and not for what a case is worth.",
      "schema:domainIncludes": [
        {
          "@id": "schema:Service"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "legal:DamagesCap"
        }
      ],
      "schema:isPartOf": {
        "@id": "https://w3id.org/servicefacts/legal"
      },
      "legal:priority": "Medium",
      "legal:module": "core",
      "legal:answersQuestion": "Is there a limit on how much I can get? Is there a cap on pain and suffering damages?",
      "legal:visibleTextRequired": true,
      "legal:priorityEvidence": "Hypothesis v0.1: from a review of law-firm service pages and the questions buyers ask. To be measured with AI prompt tracking.",
      "legal:dualPublishAs": "WebPage.citation for the law that sets the cap"
    },
    {
      "@id": "legal:appliesToDamageType",
      "@type": "rdf:Property",
      "rdfs:label": "appliesToDamageType",
      "rdfs:comment": "The kind of damages the cap limits. Value from the DamageTypes list.",
      "schema:domainIncludes": [
        {
          "@id": "legal:DamagesCap"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DefinedTerm"
        }
